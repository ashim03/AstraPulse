generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String
  slug                  String                 @unique
  phone                 String?
  country               String?
  currency              String                 @default("NPR")
  timezone              String                 @default("America/New_York")
  businessType          String?
  fiscalYearStart       Int                    @default(1)
  dateFormat            String                 @default("MM/DD/YYYY")
  logo                  String?
  status                String                 @default("active")
  suspendedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  accounts              Account[]
  announcements         Announcement[]
  attendances           Attendance[]
  attendanceAdjustments AttendanceAdjustment[]
  attendanceDevices     AttendanceDevice[]
  attendanceReminders   AttendanceReminder[]
  attendanceSettings    AttendanceSettings?
  auditLogs             AuditLog[]
  authAuditLogs         AuthAuditLog[]
  authSettings          AuthSettings?
  bankAccounts          BankAccount[]
  breaks                Break[]
  customers             Customer[]
  departments           Department[]
  documents             Document[]
  emailConfigs          EmailConfig?
  employees             Employee[]
  advances              EmployeeAdvance[]
  expenses              Expense[]
  holidays              Holiday[]
  incomes               Income[]
  invoices              Invoice[]
  journalEntries        JournalEntry[]
  leaveRequests         LeaveRequest[]
  leaveTypes            LeaveType[]
  messages              Message[]
  notifications         Notification[]
  otpVerifications      OtpVerification[]
  overtimeRecords       OvertimeRecord[]
  passwordResets        PasswordResetToken[]
  payments              Payment[]
  paymentRequests       PaymentRequest[]
  payrolls              Payroll[]
  payrollPeriods        PayrollPeriod[]
  positions             Position[]
  roles                 Role[]
  salaryConfigs         SalaryConfig[]
  subscription          Subscription?
  tasks                 Task[]
  users                 User[]
  vendors               Vendor[]
  workRecords           WorkRecord[]
}

model User {
  id                  String               @id @default(cuid())
  workspaceId         String
  name                String
  email               String
  phone               String?
  passwordHash        String
  roleId              String?
  employeeId          String?              @unique
  twoFactorSecret     String?
  twoFactorEnabled    Boolean              @default(false)
  status              String               @default("active")
  accountType         String               @default("organization")
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  emailVerified       Boolean              @default(true)
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int                  @default(0)
  lastPasswordChange  DateTime?
  lockedUntil         DateTime?
  announcements       Announcement[]
  auditLogs           AuditLog[]
  sentMessages        Message[]            @relation("SentMessages")
  receivedMessages    MessageRecipient[]
  notifications       Notification[]
  otpVerifications    OtpVerification[]
  passwordResets      PasswordResetToken[]
  taskComments        TaskComment[]
  employee            Employee?            @relation(fields: [employeeId], references: [id])
  role                Role?                @relation(fields: [roleId], references: [id])
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model Role {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  isSystem    Boolean   @default(false)
  permissions String    @default("[]")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Department {
  id            String         @id @default(cuid())
  workspaceId   String
  name          String
  description   String?
  managerId     String?
  parentId      String?
  announcements Announcement[]
  manager       Employee?      @relation("DeptManager", fields: [managerId], references: [id])
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees     Employee[]
  positions     Position[]
  tasks         Task[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Position {
  id           String      @id @default(cuid())
  workspaceId  String
  departmentId String?
  name         String
  level        String?
  salaryMin    Float?
  salaryMax    Float?
  employees    Employee[]
  department   Department? @relation(fields: [departmentId], references: [id])
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Employee {
  id                  String                 @id @default(cuid())
  workspaceId         String
  employeeId          String
  name                String
  email               String
  phone               String?
  avatar              String?
  address             String?
  city                String?
  country             String?
  dateOfBirth         DateTime?
  gender              String?
  emergencyName       String?
  emergencyPhone      String?
  emergencyRelation   String?
  departmentId        String?
  positionId          String?
  managerId           String?
  employmentType      String                 @default("full_time")
  joinDate            DateTime
  contractEndDate     DateTime?
  status              String                 @default("active")
  workLocation        String?
  baseSalary          Float                  @default(0)
  paymentMethod       String?
  bankName            String?
  bankAccountNumber   String?
  accountHolder       String?
  taxId               String?
  createdBy           String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deviceEmployeeId    String?
  salaryType          String                 @default("monthly")
  shift               String?
  attendances         Attendance[]
  adjustments         AttendanceAdjustment[]
  attendanceReminders AttendanceReminder[]
  breaks              Break[]
  managedDepartments  Department[]           @relation("DeptManager")
  department          Department?            @relation(fields: [departmentId], references: [id])
  reportsTo           Employee?              @relation("ReportsTo", fields: [managerId], references: [id])
  directReports       Employee[]             @relation("ReportsTo")
  position            Position?              @relation(fields: [positionId], references: [id])
  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  advances            EmployeeAdvance[]
  expenses            Expense[]
  leaveRequests       LeaveRequest[]
  overtimeRecords     OvertimeRecord[]
  payrollItems        PayrollItem[]
  salaryComponents    SalaryComponent[]
  salaryConfigs       SalaryConfig[]
  tasks               Task[]
  user                User?
  workRecords         WorkRecord[]

  @@unique([workspaceId, employeeId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, departmentId])
  @@index([deviceEmployeeId])
}

model SalaryComponent {
  id            String   @id @default(cuid())
  workspaceId   String
  employeeId    String
  type          String
  name          String
  amount        Float
  effectiveFrom DateTime @default(now())
  recurring     Boolean  @default(true)
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model Attendance {
  id             String    @id @default(cuid())
  workspaceId    String
  employeeId     String
  date           DateTime
  clockIn        DateTime?
  clockOut       DateTime?
  status         String    @default("present")
  hours          Float     @default(0)
  overtime       Float     @default(0)
  breakMinutes   Int       @default(0)
  location       String?
  note           String?
  source         String    @default("self")
  approvedById   String?
  deviceId       String?
  deviceRecordId String?
  earlyMinutes   Int       @default(0)
  isHalfDay      Boolean   @default(false)
  isHoliday      Boolean   @default(false)
  isWeekend      Boolean   @default(false)
  lateMinutes    Int       @default(0)
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  breaks         Break[]

  @@unique([employeeId, date])
  @@index([workspaceId])
  @@index([workspaceId, date])
  @@index([workspaceId, employeeId])
  @@index([workspaceId, status])
}

model AttendanceAdjustment {
  id          String    @id @default(cuid())
  workspaceId String
  employeeId  String
  date        DateTime
  type        String
  reason      String?
  status      String    @default("pending")
  reviewedBy  String?
  reviewedAt  DateTime?
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model LeaveType {
  id           String         @id @default(cuid())
  workspaceId  String
  name         String
  daysPerYear  Float          @default(0)
  carryForward Boolean        @default(false)
  color        String         @default("#6366f1")
  icon         String?
  requests     LeaveRequest[]
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id          String    @id @default(cuid())
  workspaceId String
  employeeId  String
  typeId      String
  startDate   DateTime
  endDate     DateTime
  days        Float
  reason      String?
  attachment  String?
  status      String    @default("pending")
  approverId  String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        LeaveType @relation(fields: [typeId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, employeeId])
  @@index([workspaceId, status])
  @@index([workspaceId, employeeId, status])
}

model Holiday {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  date        DateTime
  recurring   Boolean   @default(false)
  region      String?
  description String?
  endDate     DateTime?
  type        String    @default("public")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Task {
  id           String        @id @default(cuid())
  workspaceId  String
  title        String
  description  String?
  assigneeId   String?
  departmentId String?
  priority     String        @default("medium")
  dueDate      DateTime?
  status       String        @default("todo")
  labels       String        @default("[]")
  attachment   String?
  createdBy    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  assignee     Employee?     @relation(fields: [assigneeId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  comments     TaskComment[]
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model WorkRecord {
  id          String    @id @default(cuid())
  workspaceId String
  employeeId  String
  project     String
  date        DateTime
  startTime   String?
  endTime     String?
  hours       Float
  description String?
  billable    Boolean   @default(true)
  status      String    @default("pending")
  approvedBy  String?
  approvedAt  DateTime?
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, employeeId])
}

model EmployeeAdvance {
  id          String    @id @default(cuid())
  workspaceId String
  employeeId  String
  amount      Float
  date        DateTime
  reason      String?
  months      Int       @default(1)
  installment Float     @default(0)
  outstanding Float     @default(0)
  status      String    @default("pending")
  approvedBy  String?
  approvedAt  DateTime?
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model Payroll {
  id                String        @id @default(cuid())
  workspaceId       String
  period            String
  name              String
  status            String        @default("draft")
  grossTotal        Float         @default(0)
  deductionTotal    Float         @default(0)
  taxTotal          Float         @default(0)
  netTotal          Float         @default(0)
  employerCostTotal Float         @default(0)
  processedAt       DateTime?
  lockedAt          DateTime?
  approvedBy        String?
  approvedAt        DateTime?
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items             PayrollItem[]

  @@unique([workspaceId, period])
  @@index([workspaceId])
}

model PayrollItem {
  id               String   @id @default(cuid())
  payrollId        String
  employeeId       String
  baseSalary       Float    @default(0)
  allowances       Float    @default(0)
  bonuses          Float    @default(0)
  overtime         Float    @default(0)
  gross            Float    @default(0)
  deductions       Float    @default(0)
  tax              Float    @default(0)
  advanceDeduction Float    @default(0)
  benefits         Float    @default(0)
  net              Float    @default(0)
  employerCost     Float    @default(0)
  paymentStatus    String   @default("pending")
  absentDays       Float    @default(0)
  absentDeduction  Float    @default(0)
  halfDayDeduction Float    @default(0)
  halfDays         Float    @default(0)
  holidayPay       Float    @default(0)
  lateDeduction    Float    @default(0)
  leaveDeduction   Float    @default(0)
  overtimeHours    Float    @default(0)
  paidLeaveDays    Float    @default(0)
  presentDays      Float    @default(0)
  totalHours       Float    @default(0)
  unpaidLeaveDays  Float    @default(0)
  weekendPay       Float    @default(0)
  workingDays      Float    @default(0)
  employee         Employee @relation(fields: [employeeId], references: [id])
  payroll          Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId])
  @@index([employeeId])
}

model Expense {
  id            String    @id @default(cuid())
  workspaceId   String
  number        String
  employeeId    String?
  vendorId      String?
  category      String
  date          DateTime
  amount        Float
  tax           Float     @default(0)
  paymentMethod String?
  accountId     String?
  description   String?
  receipt       String?
  status        String    @default("draft")
  approvedBy    String?
  approvedAt    DateTime?
  account       Account?  @relation(fields: [accountId], references: [id])
  employee      Employee? @relation(fields: [employeeId], references: [id])
  vendor        Vendor?   @relation(fields: [vendorId], references: [id])
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@index([workspaceId])
}

model Income {
  id            String    @id @default(cuid())
  workspaceId   String
  number        String
  customerId    String?
  category      String
  date          DateTime
  amount        Float
  tax           Float     @default(0)
  paymentMethod String?
  accountId     String?
  description   String?
  attachment    String?
  account       Account?  @relation(fields: [accountId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Customer {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  email       String?
  phone       String?
  address     String?
  taxId       String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  incomes     Income[]
  invoices    Invoice[]
  payments    Payment[]
}

model Vendor {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  email       String?
  phone       String?
  address     String?
  taxId       String?
  expenses    Expense[]
  payments    Payment[]
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Invoice {
  id          String        @id @default(cuid())
  workspaceId String
  number      String
  customerId  String
  date        DateTime
  dueDate     DateTime
  status      String        @default("draft")
  subtotal    Float         @default(0)
  discount    Float         @default(0)
  tax         Float         @default(0)
  total       Float         @default(0)
  paid        Float         @default(0)
  terms       String?
  notes       String?
  customer    Customer      @relation(fields: [customerId], references: [id])
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items       InvoiceItem[]
  payments    Payment[]

  @@index([workspaceId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  tax         Float   @default(0)
  amount      Float   @default(0)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String       @id @default(cuid())
  workspaceId   String
  reference     String
  date          DateTime
  amount        Float
  direction     String       @default("in")
  customerId    String?
  vendorId      String?
  invoiceId     String?
  expenseId     String?
  method        String
  bankAccountId String?
  notes         String?
  reconciled    Boolean      @default(false)
  reconciledAt  DateTime?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  customer      Customer?    @relation(fields: [customerId], references: [id])
  expense       Expense?     @relation(fields: [expenseId], references: [id])
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id])
  vendor        Vendor?      @relation(fields: [vendorId], references: [id])
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model BankAccount {
  id             String    @id @default(cuid())
  workspaceId    String
  name           String
  bank           String
  accountNumber  String
  currency       String    @default("NPR")
  openingBalance Float     @default(0)
  currentBalance Float     @default(0)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payments       Payment[]
}

model Account {
  id             String        @id @default(cuid())
  workspaceId    String
  code           String
  name           String
  type           String
  parentId       String?
  openingBalance Float         @default(0)
  balance        Float         @default(0)
  status         String        @default("active")
  isSystem       Boolean       @default(false)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  incomes        Income[]
  journalLines   JournalLine[]

  @@unique([workspaceId, code])
}

model JournalEntry {
  id          String        @id @default(cuid())
  workspaceId String
  number      String
  date        DateTime
  description String
  status      String        @default("draft")
  attachment  String?
  createdBy   String?
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lines       JournalLine[]

  @@index([workspaceId])
}

model JournalLine {
  id        String       @id @default(cuid())
  journalId String
  accountId String
  debit     Float        @default(0)
  credit    Float        @default(0)
  account   Account      @relation(fields: [accountId], references: [id])
  journal   JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  module      String
  recordId    String?
  description String
  before      String?
  after       String?
  ip          String?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
}

model Announcement {
  id           String      @id @default(cuid())
  workspaceId  String
  title        String
  message      String
  audience     String      @default("all")
  departmentId String?
  priority     String      @default("normal")
  publishDate  DateTime?
  expiryDate   DateTime?
  attachment   String?
  status       String      @default("draft")
  authorId     String?
  createdAt    DateTime    @default(now())
  author       User?       @relation(fields: [authorId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Message {
  id          String             @id @default(cuid())
  workspaceId String
  senderId    String
  subject     String
  body        String?
  category    String             @default("general")
  attachment  String?
  parentId    String?
  createdAt   DateTime           @default(now())
  sender      User               @relation("SentMessages", fields: [senderId], references: [id])
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipients  MessageRecipient[]

  @@index([workspaceId])
  @@index([workspaceId, senderId])
  @@index([workspaceId, createdAt])
}

model MessageRecipient {
  id          String    @id @default(cuid())
  messageId   String
  recipientId String
  readAt      DateTime?
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient   User      @relation(fields: [recipientId], references: [id])

  @@unique([messageId, recipientId])
  @@index([recipientId])
  @@index([recipientId, readAt])
}

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  title       String
  body        String?
  type        String    @default("info")
  link        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@index([workspaceId, userId])
}

model SubscriptionPlan {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  monthlyPrice  Float
  yearlyPrice   Float
  employeeLimit Int            @default(15)
  userLimit     Int            @default(50)
  storageLimit  Int            @default(1024)
  features      String         @default("[]")
  isActive      Boolean        @default(true)
  isDefault     Boolean        @default(false)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id              String            @id @default(cuid())
  workspaceId     String            @unique
  planId          String?
  planName        String            @default("starter")
  status          String            @default("active")
  billingPeriod   String            @default("monthly")
  price           Float             @default(49)
  employeeLimit   Int               @default(15)
  userLimit       Int               @default(50)
  storageLimit    Int               @default(1024)
  isTrial         Boolean           @default(false)
  trialEndDate    DateTime?
  paymentStatus   String            @default("unpaid")
  approvedBy      String?
  approvedAt      DateTime?
  startDate       DateTime          @default(now())
  renewalDate     DateTime
  paymentRequests PaymentRequest[]
  plan            SubscriptionPlan? @relation(fields: [planId], references: [id])
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model PaymentRequest {
  id             String        @id @default(cuid())
  workspaceId    String
  subscriptionId String?
  amount         Float
  method         String        @default("card")
  reference      String
  qrCode         String?
  status         String        @default("pending")
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime      @default(now())
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Document {
  id          String    @id @default(cuid())
  workspaceId String
  entityType  String
  entityId    String
  name        String
  filePath    String
  type        String?
  size        Int       @default(0)
  expiresAt   DateTime?
  uploadedBy  String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType, entityId])
}

model AttendanceDevice {
  id              String                @id @default(cuid())
  workspaceId     String
  name            String
  model           String?
  ipAddress       String
  port            Int                   @default(4370)
  location        String?
  protocol        String                @default("TCP")
  username        String?
  password        String?
  status          String                @default("offline")
  lastSyncAt      DateTime?
  lastSyncStatus  String?
  syncInterval    Int                   @default(30)
  autoSync        Boolean               @default(false)
  firmwareVersion String?
  serialNumber    String?
  errorMessage    String?
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs            AttendanceDeviceLog[]

  @@unique([workspaceId, ipAddress])
  @@index([workspaceId])
}

model AttendanceDeviceLog {
  id            String           @id @default(cuid())
  deviceId      String
  type          String
  status        String
  message       String?
  recordsSynced Int              @default(0)
  duration      Int?
  createdAt     DateTime         @default(now())
  device        AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}

model AttendanceSettings {
  id                       String    @id @default(cuid())
  workspaceId              String    @unique
  officeStartTime          String    @default("10:00")
  officeEndTime            String    @default("18:00")
  officeTimezone           String    @default("Asia/Kathmandu")
  graceMinutes             Int       @default(15)
  absentIfLateByMinutes    Int       @default(0)
  halfDayAfterMinutes      Int       @default(240)
  minimumWorkMinutes       Int       @default(180)
  workingDays              String    @default("[\"mon\",\"tue\",\"wed\",\"thu\",\"fri\"]")
  weekendDays              String    @default("[\"sat\",\"sun\"]")
  overtimeEnabled          Boolean   @default(true)
  overtimeRequiresApproval Boolean   @default(true)
  overtimeRateMultiplier   Float     @default(1.5)
  weekendOvertimeRate      Float     @default(2.0)
  holidayOvertimeRate      Float     @default(2.5)
  breakEnabled             Boolean   @default(true)
  breakStartTime           String?   @default("12:00")
  breakEndTime             String?   @default("13:00")
  breakDurationMinutes     Int       @default(60)
  maxBreaksPerDay          Int       @default(1)
  breakIsPaid              Boolean   @default(false)
  remindersEnabled         Boolean   @default(false)
  reminderStartHour        String    @default("10:00")
  reminderEndHour          String    @default("17:00")
  maxRemindersPerDay       Int       @default(8)
  reminderEmailEnabled     Boolean   @default(true)
  lateDeductionEnabled     Boolean   @default(true)
  lateDeductionPerMinute   Float     @default(0)
  absentDeductionEnabled   Boolean   @default(true)
  halfDayDeductionPercent  Float     @default(50)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Break {
  id           String     @id @default(cuid())
  workspaceId  String
  attendanceId String
  employeeId   String
  breakOut     DateTime
  breakIn      DateTime?
  duration     Int        @default(0)
  status       String     @default("active")
  isPaid       Boolean    @default(false)
  note         String?
  createdAt    DateTime   @default(now())
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([employeeId])
}

model OvertimeRecord {
  id          String    @id @default(cuid())
  workspaceId String
  employeeId  String
  date        DateTime
  hours       Float
  type        String
  rate        Float     @default(1.5)
  status      String    @default("pending")
  approvedBy  String?
  approvedAt  DateTime?
  note        String?
  createdAt   DateTime  @default(now())
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([employeeId, date])
}

model EmailConfig {
  id           String    @id @default(cuid())
  workspaceId  String    @unique
  provider     String    @default("brevo")
  apiKey       String
  senderName   String
  senderEmail  String
  replyToEmail String?
  isEnabled    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AuthSettings {
  id                             String    @id @default(cuid())
  workspaceId                    String    @unique
  emailVerificationRequired      Boolean   @default(true)
  loginOtpEnabled                Boolean   @default(false)
  otpExpirationMinutes           Int       @default(5)
  otpLength                      Int       @default(6)
  maxOtpAttempts                 Int       @default(5)
  otpResendCooldownSeconds       Int       @default(60)
  maxOtpResends                  Int       @default(3)
  passwordMinLength              Int       @default(8)
  passwordRequireUppercase       Boolean   @default(true)
  passwordRequireLowercase       Boolean   @default(true)
  passwordRequireNumber          Boolean   @default(true)
  passwordRequireSpecial         Boolean   @default(true)
  passwordResetExpirationMinutes Int       @default(15)
  sessionTimeoutMinutes          Int       @default(480)
  forceLogoutOnPasswordChange    Boolean   @default(true)
  maxFailedLoginAttempts         Int       @default(5)
  lockoutDurationMinutes         Int       @default(30)
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
  workspace                      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model OtpVerification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  email       String
  codeHash    String
  type        String
  expiresAt   DateTime
  attempts    Int       @default(0)
  verified    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email, type])
  @@index([workspaceId])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  tokenHash   String
  expiresAt   DateTime
  used        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
}

model AuthAuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  email       String
  action      String
  success     Boolean
  ip          String?
  userAgent   String?
  metadata    String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@index([userId])
}

model PayrollPeriod {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  frequency   String    @default("monthly")
  startDate   DateTime
  endDate     DateTime
  paymentDate DateTime
  status      String    @default("upcoming")
  isCurrent   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, isCurrent])
}

model SalaryConfig {
  id                    String    @id @default(cuid())
  workspaceId           String
  employeeId            String?
  salaryType            String    @default("monthly")
  baseSalary            Float     @default(0)
  currency              String    @default("NPR")
  taxEnabled            Boolean   @default(true)
  taxRate               Float     @default(0)
  socialSecurityEnabled Boolean   @default(false)
  socialSecurityRate    Float     @default(0)
  providentFundEnabled  Boolean   @default(false)
  providentFundRate     Float     @default(0)
  insuranceEnabled      Boolean   @default(false)
  insuranceAmount       Float     @default(0)
  effectiveFrom         DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  employee              Employee? @relation(fields: [employeeId], references: [id])
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([employeeId])
}

model AttendanceReminder {
  id          String    @id @default(cuid())
  workspaceId String
  employeeId  String
  date        DateTime
  type        String
  sentAt      DateTime  @default(now())
  channel     String    @default("email")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([employeeId, date])
}
